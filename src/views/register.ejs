<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/register" method="POST" class="account-form">
        <div class="form-group">
            <label for="name">Name</label>
            <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                required
            />
        </div>
        
        <div class="form-group">
            <label for="email">Email (Username)</label>
            <input
                class="form-control"
                type="email"
                id="email"
                name="email"
                required
            />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input
                class="form-control"
                type="password"
                id="password"
                name="password"
                required
            />
        </div>

        <button class="primary-button" type="submit">Register</button>
    </form>

</main>
<%- include('partials/footer') %>