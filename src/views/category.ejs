<%- include('partials/header') %>
<main>
    <h1><%= categoryData.category_name %></h1>

    <h2>Service Projects</h2>
    <% if (categoryProjects && categoryProjects.length > 0) { %>
      <ul>
        <% categoryProjects.forEach(project => { %>
          <li>
            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No service projects found.</p>
    <% } %>
</main>

<%- include('partials/footer') %>