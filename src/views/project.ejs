<%- include('partials/header') %>

<main>
  <div class="category-tags">
    <h3>Categories:</h3>
    <% if (projectCategory && projectCategory.length > 0) { %>
      <ul>
        <% projectCategory.forEach(category => { %>
          <li>
            <a href="/category/<%= category.category_id %>">
              <%= category.category_name %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No categories assigned to this project.</p>
    <% } %>
  </div>

  <h1><%= projectDetails.title %></h1>
  <p><%= projectDetails.description %></p>
  <p>Date: <%= projectDetails.project_date %></p>
  <p>Location: <%= projectDetails.location %></p>
  <p>
    Organization: 
    <a href="/organization/<%= projectDetails.organization_id %>">
      <%= projectDetails.organization_name %>
    </a>
  </p>

  <% if (user && user.role_name === 'admin') { %>
  <p class="new-org-link"><a href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a></p>
   <% } %>
   
  <% if (user && user.role_name === 'admin') { %>
    <p class="new-org-link"><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
  <% } %>

  


  <% if (user && isMember) { %>
    <div class="project-membership-actions">
      <p>You volunteered For this project</p>
      <form action="/leave-project/<%= projectDetails.project_id %>" method="post">
        <button class="secondary-button" type="submit">Leave This Project</button>
      </form>
    </div>
  <% } %>

  <% if (user && !isMember) { %>
    <div class="project-membership-actions">
      <form action="/join-project/<%= projectDetails.project_id %>" method="post">
        <button class="primary-button" type="submit">volunteer For Project</button>
      </form>
    </div>
  <% } %>
    
  </div>

</main>

<%- include('partials/footer') %>